<!--
    Login View
    This view is displayed when a user tries to log in.
-->

@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<!-- Login Form -->
<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-guitar fa-3x text-primary mb-3"></i>
                        <h2 class="fw-bold">Welcome Back</h2>
                        <p class="text-muted">Sign in to access your collection</p>
                    </div>

                    <form method="post" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="UserName" class="form-control" placeholder="Username" id="floatingInput" />
                            <label asp-for="UserName" for="floatingInput">Username</label>
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password"
                                id="floatingPassword" />
                            <label asp-for="Password" for="floatingPassword">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me on this
                                device</label>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="text-muted small">
                                Don't have an account?
                                <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Create
                                    one</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">
                    <i class="fa-solid fa-arrow-left"></i> Back to the master repertoire
                </a>
            </div>
        </div>
    </div>
</div>
