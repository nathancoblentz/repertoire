@model IEnumerable<Project>
@{
    ViewData["Title"] = "Project Catalogs";
}

<div class="mb-5">
    <h1 class="display-1 fw-bold"><i class="fa-solid fa-layer-group text-primary"></i> Musical Catalogs</h1>
    <p class="lead text-muted">Select a project to view its full song catalog and details.</p>
</div>

<div class="row g-4">
    @foreach (var p in Model)















    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 hover-lift transition">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary">
                            <i class="fa-solid fa-microphone-lines fa-2x"></i>
                        </div>
                        <span class="badge bg-dark rounded-pill">@p.Songs.Count Songs</span>
                    </div>
                    <h3 class="fw-bold h4">@p.Name</h3>
                    <p class="text-muted small mb-4">Dedicated catalog for this musical collaboration or project.</p>
                    <div class="d-grid">
                        <a asp-action="Details" asp-route-id="@p.ProjectId" class="btn btn-outline-primary fw-bold">
                            View Catalog <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-5">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left"></i> Back to Repertoire
    </a>
</div>
