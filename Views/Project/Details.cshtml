@model Project
@{
    ViewData["Title"] = Model.Name + " Catalog";
}

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Repertoire</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Project" asp-action="Index">Projects</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Catalog</li>
                </ol>
            </nav>
            <h1 class="display-1 fw-bold mb-0">
                <i class="fa-solid fa-microphone-lines text-info"></i> @Model.Name
            </h1>
            <p class="lead text-muted mt-2">Project Catalog • @Model.Songs.Count Songs</p>
        </div>
        <div class="d-print-none">
            <button onclick="window.print()" class="btn btn-outline-info shadow-sm">
                <i class="fa-solid fa-print"></i> Print Catalog
            </button>
        </div>
    </div>
</div>

<div class="card shadow border-0 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="catalog-table">
                <thead class="table-info">
                    <tr>
                        <th class="ps-4" style="width: 50px;">#</th>
                        <th>Song Title</th>
                        <th>Artist / Band</th>
                        <th class="text-center">Resources</th>
                        <th class="text-center">Status</th>
                        <th class="text-center d-print-none">Saved</th>
                    </tr>
                </thead>
                <tbody class="fs-5">
                    @{
                        int i = 1;
                    }
                    @foreach (var song in Model.Songs)

                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(i++)</td>
                            <td class="text-muted fw-bold py-3 pr-4">@song.Title</td>
                            <td class="text-secondary">@song.Artist</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(song.YouTubeUrl))

                                {
                                    <a href="@song.YouTubeUrl" target="_blank" class="text-danger me-2"
                                        title="Watch on YouTube">
                                        <i class="fa-brands fa-youtube fa-lg"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(song.SongChart))

                                {
                                    <a href="@song.SongChart" target="_blank" class="text-info" title="View Chart / Lead Sheet">
                                        <i class="fa-solid fa-scroll fa-lg"></i>
                                    </a>
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    string badgeClass = song.Status.ToLower() switch
                                    {

                                        "ready" => "bg-success",

                                        "learning" => "bg-warning text-dark",

                                        "requested" => "bg-secondary",

                                        "new" => "bg-info text-dark",

                                        _ => "bg-secondary"

                                    };
                                }
                                <span class="badge @badgeClass shadow-sm px-3">@song.Status.ToUpper()</span>
                            </td>
                            <td class="text-center d-print-none">
                                @{
                                    var isFav = ((List<int>)ViewBag.FavoriteSongIds).Contains(song.SongId);
                                }
                                <a asp-controller="Home" asp-action="@(isFav ? "Remove" : "Add")"
                                    asp-route-id="@song.SongId"
                                    class="btn @(isFav ? "btn-danger" : "btn-outline-danger") btn-sm rounded-circle shadow-sm"
                                    title="@(isFav ? "Remove from Favorites" : "Add to Favorites")">
                                    <i class="fa-solid fa-heart"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style type="text/css" media="print">
    .navbar,
    .breadcrumb,
    .d-print-none,
    footer {
        display: none !important;
    }

    .container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    .table thead th {
        background-color: #f8f9fa !important;
        color: #000 !important;
        border: 1px solid #ddd !important;
    }

    .table td {
        border: 1px solid #eee !important;
        padding: 15px !important;
    }

    h1 {
        font-size: 24pt !important;
        margin-bottom: 20px !important;
    }

    body {
        background-color: white !important;
        color: black !important;
    }
</style>

<div class="mt-5 d-print-none">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left"></i> Back to Repertoire
    </a>
</div>
