<!--
    Favorites View
    This view is displayed when a user wants to view their favorite songs.
-->

@model List<Song>
@{
    ViewData["Title"] = "My Favorites";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="display-1 fw-bold text-danger mb-0"><i class="fa-solid fa-heart"></i> My Collection</h1>
        <p class="text-muted mb-0">Your personally saved repertoire for quick access.</p>
    </div>
    <div class="d-flex gap-3 align-items-center ms-md-auto">
        <div class="input-group input-group-sm" style="width: 250px;">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text" id="favSearch" class="form-control border-start-0 ps-0" placeholder="Filter favorites..."
                aria-label="Search favorites">
        </div>
        <span class="badge bg-danger rounded-pill px-3 py-2">@Model.Count Songs</span>
    </div>
</div>

@if (Model == null || Model.Count == 0)



{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <div class="mb-4">
                <i class="fa-solid fa-heart-crack fa-4x text-muted opacity-25"></i>
            </div>
            <h3 class="text-muted">Your collection is empty</h3>
            <p class="text-muted mb-4 small">Save your favorite songs from the master repertoire for fast, stage-ready
                access.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-danger px-5">
                <i class="fa-solid fa-guitar me-2"></i> Browse All Songs
            </a>
        </div>
    </div>
}



else



{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4 sortable" style="cursor: pointer;">Title <i
                                    class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable" style="cursor: pointer;">Artist <i
                                    class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable" style="cursor: pointer;">Project <i
                                    class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable" style="cursor: pointer;">Status <i
                                    class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="text-center">Resources</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="favTableBody">
                        <!--
                                Loop through the songs in the model
                            -->
                        @foreach (var song in Model)



                        {
                            <tr>
                                <td class="fw-bold ps-4">@song.Title</td>
                                <td class="text-muted">@song.Artist</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-75">@(song.Project?.Name ?? "No Project")</span>
                                </td>
                                <td>
                                    @{
                                        string badgeClass = song.Status.ToLower() switch

                                        {



                                            // Set the badge class based on the song status



                                            "ready" => "bg-success",



                                            "learning" => "bg-warning text-dark",



                                            "requested" => "bg-secondary",



                                            "new" => "bg-info text-dark",



                                            _ => "bg-secondary"



                                        };
                                    }
                                    <span class="badge @badgeClass px-3">@song.Status</span>
                                </td>
                                <td class="text-center">
                                    <!--
                                                Check if the song has a YouTube URL
                                            -->
                                    @if (!string.IsNullOrEmpty(song.YouTubeUrl))



                                    {
                                        <a href="@song.YouTubeUrl" target="_blank" class="text-danger me-2"
                                            title="Watch on YouTube">
                                            <i class="fa-brands fa-youtube fa-lg"></i>
                                        </a>
                                    }
                                    <!--
                                                Check if the song has a song chart
                                            -->
                                    @if (!string.IsNullOrEmpty(song.SongChart))



                                    {
                                        <a href="@song.SongChart" target="_blank" class="text-info" title="View Chart / Lead Sheet">
                                            <i class="fa-solid fa-scroll fa-lg"></i>
                                        </a>
                                    }
                                </td>
                                <td class="text-center">
                                    <!--
                                                Remove the song from favorites
                                            -->
                                    <a asp-controller="Home" asp-action="Remove" asp-route-id="@song.SongId"
                                        class="btn btn-outline-danger btn-sm rounded-pill px-4 shadow-sm"
                                        title="Remove from favorites">
                                        <i class="fa-solid fa-heart-crack"></i> Remove
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!--
    Back to repertoire button
-->
<div class="mt-4">
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Repertoire
    </a>
</div>

<!--
    Scripts
-->
@section Scripts {
    <script>

        // Live favorites filtering
        $(document).ready(function () {
            $("#favSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#favTableBody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Table sorting logic
            $('th.sortable').click(function () {
                var table = $(this).parents('table').eq(0);
                var tbody = table.find('tbody');
                var rows = tbody.find('tr').toArray().sort(comparer($(this).index()));
                this.asc = !this.asc;
                if (!this.asc) { rows = rows.reverse(); }
                for (var i = 0; i < rows.length; i++) { tbody.append(rows[i]); }

                table.find('th i').addClass('opacity-50').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                $(this).find('i').removeClass('opacity-50 fa-sort').addClass(this.asc ? 'fa-sort-up' : 'fa-sort-down');
            });

            // Comparer function for sorting
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index);
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
                };
            }

            // Get cell value
            function getCellValue(row, index) {
                return $(row).children('td').eq(index).text();
            }
        });
    </script>
}