@model IEnumerable<Project>
@{
    ViewData["Title"] = "Manage Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <h1 class="display-1 fw-bold"><i class="fa-solid fa-folder-tree text-primary"></i> Project Management</h1>
    <a asp-action="Add" class="btn btn-success shadow-sm">
        <i class="fa-solid fa-plus-circle"></i> Create New Project
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Project Name</th>
                        <th class="text-center" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold ps-4">
                                <i class="fa-solid fa-folder text-warning me-2"></i> @p.Name
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-primary btn-sm px-3 border-end">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@p.ProjectId" class="btn btn-danger btn-sm px-3">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left"></i> Back to Repertoire
    </a>
</div>
