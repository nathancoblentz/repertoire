@model IEnumerable<Song>
@{
    ViewData["Title"] = "Manage Repertoire";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="display-1 fw-bold mb-0"><i class="fa-solid fa-music text-primary"></i> Manage Repertoire</h1>
    </div>
    <div class="d-flex gap-3 align-items-center ms-md-auto">
        <div class="input-group" style="width: 280px;">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text" id="adminSongSearch" class="form-control border-start-0 ps-0 shadow-none" placeholder="Filter repertoire..." aria-label="Search repertoire">
        </div>
        <a asp-area="Admin" asp-controller="Songs" asp-action="Add" class="btn btn-success px-4 py-2 shadow-sm">
            <i class="fa-solid fa-plus-circle me-2"></i> Add New Song
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-music fa-4x text-muted mb-3 opacity-25"></i>
            <h3 class="text-muted">The repertoire is empty</h3>
            <p class="text-muted mb-4">Start building your database by adding your first song.</p>
            <a asp-area="Admin" asp-controller="Songs" asp-action="Add" class="btn btn-success btn-lg px-5">
                <i class="fa-solid fa-plus-circle me-2"></i> Add First Song
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4 sortable" style="cursor: pointer;">Title <i class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable" style="cursor: pointer;">Artist <i class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable d-none d-md-table-cell" style="cursor: pointer;">Status <i class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable d-none d-lg-table-cell" style="cursor: pointer;">Project <i class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="sortable d-none d-xl-table-cell" style="cursor: pointer;">Added By <i class="fa-solid fa-sort ms-1 opacity-50 small"></i></th>
                            <th class="text-center">Res.</th>
                            <th class="text-center" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="adminSongTableBody">
                        @foreach (var song in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @song.Title
                                </td>
                                <td>@song.Artist</td>
                                <td class="d-none d-md-table-cell">
                                    @{
                                        string badgeClass = song.Status.ToLower() switch {
                                            "ready" => "bg-success",
                                            "learning" => "bg-warning text-dark",
                                            "requested" => "bg-secondary",
                                            "new" => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@song.Status</span>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    <a asp-controller="Project" asp-action="Details" asp-route-id="@(song.Project?.ProjectId ?? 0)" class="text-decoration-none" asp-area="">
                                        <span class="badge bg-secondary">@(song.Project?.Name ?? "No Project")</span>
                                    </a>
                                </td>
                                <td class="d-none d-xl-table-cell"><small class="text-muted">@(song.User?.UserName ?? "System")</small></td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(song.YouTubeUrl))
                                    {
                                        <a href="@song.YouTubeUrl" target="_blank" class="text-danger me-2" title="Watch on YouTube">
                                            <i class="fa-brands fa-youtube fa-lg"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(song.SongChart))
                                    {
                                        <a href="@song.SongChart" target="_blank" class="text-info" title="View Chart / Lead Sheet">
                                            <i class="fa-solid fa-scroll fa-lg"></i>
                                        </a>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-area="Admin" asp-controller="Songs" asp-action="Edit" asp-route-id="@song.SongId"
                                            class="btn btn-primary btn-sm shadow-sm me-1" title="Edit">
                                            <i class="fa-solid fa-file-pen"></i> <span class="d-none d-xxl-inline">Edit</span>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Songs" asp-action="Delete" asp-route-id="@song.SongId"
                                            class="btn btn-danger btn-sm shadow-sm me-1" title="Delete">
                                            <i class="fa-solid fa-trash-can"></i> <span class="d-none d-xxl-inline">Delete</span>
                                        </a>
                                        @{
                                            var favIds = (List<int>?)ViewBag.FavoriteSongIds ?? new List<int>();
                                            var isFav = favIds.Contains(song.SongId);
                                        }
                                        <a asp-area="" asp-controller="Home" asp-action="@(isFav ? "Remove" : "Add")" asp-route-id="@song.SongId"
                                            class="btn @(isFav ? "btn-danger" : "btn-outline-danger") btn-sm shadow-sm" title="@(isFav ? "Remove from Favorites" : "Add to Favorites")">
                                            <i class="fa-solid fa-heart"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Live song filtering for admin table
            $("#adminSongSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#adminSongTableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Admin Table sorting logic
            $('th.sortable').click(function() {
                var table = $(this).parents('table').eq(0);
                var tbody = table.find('tbody');
                var rows = tbody.find('tr').toArray().sort(comparer($(this).index()));
                this.asc = !this.asc;
                if (!this.asc) { rows = rows.reverse(); }
                for (var i = 0; i < rows.length; i++) { tbody.append(rows[i]); }
                
                // Update icons
                table.find('th i').addClass('opacity-50').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                $(this).find('i').removeClass('opacity-50 fa-sort').addClass(this.asc ? 'fa-sort-up' : 'fa-sort-down');
            });

            function comparer(index) {
                return function(a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index);
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
                };
            }

            function getCellValue(row, index) { 
                return $(row).children('td').eq(index).text(); 
            }
        });
    </script>
}
